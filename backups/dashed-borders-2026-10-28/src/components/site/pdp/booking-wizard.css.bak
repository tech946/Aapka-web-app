/* ==========================================================================
   Book now modal (BookingWizard.tsx) — 480×560 single panel (20px
   gutters), 4px progress segments with 4px gaps, 56px calendar days,
   28px stepper buttons, 48px footer buttons. Desert Ember tokens.
   ========================================================================== */

:where(.bw-overlay) :where(p, b, small, span) { margin: 0; font-family: inherit; }

.bw-overlay {
  position: fixed;
  inset: 0;
  z-index: 1000;
  display: grid;
  place-items: center;
  padding: 16px;
  background: color-mix(in srgb, var(--black) 62%, transparent);
  font-family: var(--font-sans);
  animation: bw-fade .18s ease;
}
@keyframes bw-fade { from { opacity: 0; } }

.bw {
  display: grid;
  grid-template-columns: minmax(0, 1fr);
  width: 480px;
  max-width: 100%;
  height: 560px;
  max-height: calc(100vh - 32px);
  overflow: hidden;
  background: var(--card);
  border-radius: 16px;
  color: var(--ink);
  animation: bw-rise .22s ease;
}
@keyframes bw-rise { from { transform: translateY(12px); opacity: 0; } }

/* ── question panel ─────────────────────────────────────────────────── */
.bw-panel { display: flex; flex-direction: column; min-width: 0; min-height: 0; }
.bw-head { flex: none; padding: 20px 20px 0; }
.bw-head__row { display: flex; align-items: center; gap: 8px; }
.bw-head__text { flex: 1; min-width: 0; display: flex; flex-direction: column; gap: 2px; }
.bw-eyebrow { color: var(--muted); font-size: 12px; font-weight: 600; line-height: 16px; letter-spacing: .06em; text-transform: uppercase; }
.bw-title { min-width: 0; font-size: 18px; font-weight: 700; line-height: 24px; }
.bw-icon {
  display: grid;
  place-items: center;
  width: 24px;
  height: 24px;
  padding: 0;
  background: none;
  border: 0;
  color: var(--ink);
  cursor: pointer;
}
.bw-icon svg { width: 20px; height: 20px; }
.bw-progress { display: flex; gap: 4px; margin-top: 16px; }
.bw-progress span { flex: 1; height: 4px; border-radius: 2px; background: var(--border); transition: background-color .2s ease; }
.bw-progress span.is-on { background: var(--brand); }

.bw-body { flex: 1; min-height: 0; overflow-y: auto; padding: 20px; overscroll-behavior: contain; }
.bw-body--cal { padding-top: 0; }
.bw-loading { padding: 40px 0; color: var(--muted); text-align: center; }

/* travellers box (their "Room 1") */
.bw-room { border: 1px solid var(--border); border-radius: var(--radius-sm); }
.bw-room__head { padding: 20px 24px; font-size: 14px; font-weight: 500; line-height: 20px; text-transform: uppercase; }
.bw-room__note { margin: -8px 24px 12px; color: var(--muted); font-size: 13px; line-height: 18px; }
.bw-row { display: flex; align-items: center; justify-content: space-between; gap: 12px; padding: 0 24px; }
.bw-row + .bw-row { margin-top: 12px; }
.bw-row:last-child { padding-bottom: 20px; }
.bw-row__label { font-size: 14px; font-weight: 500; line-height: 20px; }
.bw-row__label b { font-weight: 700; }
.bw-row__label small { display: block; color: var(--muted); font-size: 12px; line-height: 16px; }
.bw-step { flex: none; display: flex; align-items: center; }
.bw-step button {
  display: grid;
  place-items: center;
  width: 28px;
  height: 28px;
  padding: 0;
  background: none;
  border: 1px solid var(--muted);
  border-radius: 6px;
  color: var(--ink);
  cursor: pointer;
}
.bw-step button:disabled { opacity: .35; cursor: default; }
.bw-step button:not(:disabled):hover { background: var(--surface); }
.bw-step svg { width: 16px; height: 16px; }
.bw-step p { width: 32px; font-size: 16px; font-weight: 700; line-height: 24px; text-align: center; }

/* calendar: months one under the other */
.bw-month { padding-top: 20px; }
.bw-month__title { font-size: 18px; font-weight: 600; line-height: 28px; text-align: center; }
.bw-grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); margin-top: 24px; }
.bw-grid__wd { padding-bottom: 8px; color: var(--muted); font-size: 16px; font-weight: 500; line-height: 24px; text-align: center; }
.bw-grid > span { height: 60px; }
.bw-day {
  height: 56px;
  margin: 2px 0;
  padding: 12px 8px;
  background: none;
  border: 0;
  border-radius: var(--radius-sm);
  color: var(--ink);
  font: inherit;
  font-size: 16px;
  font-weight: 500;
  line-height: 24px;
  cursor: pointer;
  transition: background-color .12s ease;
}
.bw-day:not(:disabled):hover { background: var(--surface); }
.bw-day.is-today { background: var(--brand-tint); }
.bw-day:disabled { color: var(--ash); cursor: default; }
.bw-day.is-on { background: var(--brand); color: var(--on-brand); font-weight: 700; }

/* footer */
.bw-foot { flex: none; display: flex; align-items: center; gap: 16px; padding: 16px 20px 20px; border-top: 1px solid var(--border); }
.bw-btn {
  flex: 1;
  height: 48px;
  padding: 0 20px;
  background: none;
  border: 1px solid var(--ash);
  border-radius: var(--radius-sm);
  color: var(--ink);
  font: inherit;
  font-size: 14px;
  font-weight: 500;
  line-height: 20px;
  cursor: pointer;
}
.bw-btn:hover { background: var(--surface); }
.bw-btn--go {
  background: var(--brand);
  border: 1px dashed var(--brand-edge);
  box-shadow: 0 1px 3px color-mix(in srgb, var(--black) 10%, transparent), 0 1px 2px -1px color-mix(in srgb, var(--black) 10%, transparent);
  color: var(--on-brand);
  font-size: 16px;
  font-weight: 600;
  line-height: 24px;
}
.bw-btn--go:hover { background: var(--brand-hover); }
.bw-btn--go:disabled { opacity: .5; cursor: default; background: var(--brand); }
.bw-total { flex: 1; display: flex; flex-direction: column; min-width: 0; }
.bw-total small { overflow: hidden; color: var(--muted); font-size: 12px; line-height: 16px; white-space: nowrap; text-overflow: ellipsis; }
.bw-total b { font-size: 18px; font-weight: 800; line-height: 24px; }

/* ── phones: full-screen ───────────────────────────────────────────── */
@media (max-width: 767px) {
  .bw-overlay { padding: 0; }
  .bw { width: 100%; height: 100%; max-height: none; border-radius: 0; }
  .bw-foot { padding-bottom: calc(20px + env(safe-area-inset-bottom, 0px)); }
  .bw-day { height: 48px; padding: 8px 4px; }
  .bw-grid > span { height: 52px; }
}
