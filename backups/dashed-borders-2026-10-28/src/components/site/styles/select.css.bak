/* ===========================================================================
   select.css — the site's one dropdown (components/site/ui/Select.tsx), in
   the new cream / dark-green design. Not scoped to a page: the trigger and
   the menu (portaled to <body>) carry their own palette, read from the
   --fr-* tokens with the same values as fallbacks, so the dropdown looks the
   same on every marketing page. Pages can still resize the trigger.
   =========================================================================== */

.dd,
.dd-menu {
  --dd-ink: var(--fr-dark, #141414);
  --dd-text: var(--fr-brown, #221e1b);
  --dd-paper: var(--fr-cream, #ffffff);
  --dd-pick: var(--fr-lime, #ffbf9b);
  --dd-glow: var(--fr-yellow, #f26f39);
  --dd-danger: var(--lx-danger, #dc4a4a);
  --dd-radius: var(--fr-radius, 6px);
}

.dd {
  position: relative;
  display: block;
  width: 100%;
  min-width: 0;
  font-family: inherit;
}

/* ── trigger ─────────────────────────────────────────────────────────── */

.dd-btn {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  box-sizing: border-box;
  width: 100%;
  min-height: 44px;
  height: 44px;
  margin: 0;
  padding: 0 12px 0 14px;
  border: 1px dashed var(--dd-ink);
  border-radius: var(--dd-radius);
  background-color: transparent;
  box-shadow: none;
  color: var(--dd-text);
  font-family: inherit;
  font-size: 16px;
  font-weight: 500;
  line-height: 1.2;
  text-align: left;
  cursor: pointer;
  outline: 0;
  transition:
    border-color 0.2s ease,
    background-color 0.2s ease;
}

.dd-btn:hover:not(:disabled) {
  background-color: color-mix(in srgb, var(--dd-glow) 12%, transparent);
}

.dd.is-open .dd-btn,
.dd-btn:focus-visible {
  border-style: solid;
  border-color: var(--dd-ink);
  background-color: color-mix(in srgb, var(--dd-glow) 18%, transparent);
  outline: none;
  box-shadow: none;
}

.dd.is-invalid .dd-btn {
  border-color: var(--dd-danger);
}

.dd-btn:disabled {
  cursor: not-allowed;
  opacity: 0.55;
}

.dd-value {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.dd-value.is-ph {
  color: var(--dd-text);
  font-weight: 400;
  opacity: 0.5;
}

.dd-chev {
  flex-shrink: 0;
  width: 18px;
  height: 18px;
  color: var(--dd-ink);
  transition: transform 0.2s ease;
}

.dd.is-open .dd-chev {
  transform: rotate(180deg);
}

/* small: toolbars and inline use (sort, dial codes) */
.dd.is-sm {
  width: auto;
  min-width: 90px;
}

.dd.is-sm .dd-btn {
  min-height: 38px;
  height: 38px;
  padding: 0 10px 0 12px;
  font-size: 15px;
}

.dd.is-sm .dd-chev {
  width: 16px;
  height: 16px;
}

/* ── menu (portaled to <body>) ───────────────────────────────────────── */

.dd-menu {
  z-index: 1100;
  box-sizing: border-box;
  min-width: 160px;
  padding: 6px;
  border: 1px solid var(--dd-ink);
  border-radius: 10px;
  background-color: var(--dd-paper);
  box-shadow: 0 14px 34px color-mix(in srgb, var(--dd-ink) 22%, transparent);
  color: var(--dd-text);
  font-size: 16px;
  -webkit-font-smoothing: antialiased;
  animation: dd-in 0.12s ease-out both;
}

.dd-menu *,
.dd-menu *::before,
.dd-menu *::after {
  box-sizing: border-box;
}

@keyframes dd-in {
  from {
    opacity: 0;
    transform: translateY(-3px);
  }
  to {
    opacity: 1;
    transform: none;
  }
}

.dd-menu.is-up {
  animation-name: dd-in-up;
}

@keyframes dd-in-up {
  from {
    opacity: 0;
    transform: translateY(3px);
  }
  to {
    opacity: 1;
    transform: none;
  }
}

.dd-search {
  display: flex;
  align-items: center;
  gap: 8px;
  height: 42px;
  margin: 0 0 6px;
  padding: 0 12px;
  border: 1px dashed var(--dd-ink);
  border-radius: var(--dd-radius);
  background-color: transparent;
  transition: background-color 0.2s ease;
}

.dd-search:focus-within {
  border-style: solid;
  background-color: color-mix(in srgb, var(--dd-glow) 18%, transparent);
}

.dd-search svg {
  flex-shrink: 0;
  width: 16px;
  height: 16px;
  color: var(--dd-ink);
}

.dd-search input {
  flex: 1;
  min-width: 0;
  height: 100%;
  margin: 0;
  padding: 0;
  border: 0;
  background: transparent;
  box-shadow: none;
  color: var(--dd-text);
  font: inherit;
  font-size: 16px;
  outline: none;
}

.dd-search input::placeholder {
  color: var(--dd-text);
  opacity: 0.5;
}

.dd-list {
  display: flex;
  flex-direction: column;
  gap: 2px;
  max-height: 272px;
  margin: 0;
  padding: 0;
  overflow-y: auto;
  overscroll-behavior: contain;
  list-style: none;
  scrollbar-width: thin;
  scrollbar-color: color-mix(in srgb, var(--dd-ink) 35%, transparent) transparent;
}

.dd-list li {
  margin: 0;
  padding: 0;
}

.dd-opt {
  display: flex;
  align-items: center;
  gap: 10px;
  width: 100%;
  min-height: 40px;
  margin: 0;
  padding: 8px 10px 8px 12px;
  border: 0;
  border-radius: var(--dd-radius);
  background-color: transparent;
  color: var(--dd-text);
  font: inherit;
  font-size: 16px;
  font-weight: 500;
  line-height: 1.3;
  text-align: left;
  cursor: pointer;
  transition: background-color 0.12s ease;
}

.dd-opt:hover,
.dd-opt.is-hi {
  background-color: color-mix(in srgb, var(--dd-glow) 30%, transparent);
}

.dd-opt.is-on {
  background-color: var(--dd-pick);
  color: var(--dd-ink);
  font-weight: 600;
}

.dd-opt-label {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  text-overflow: ellipsis;
}

.dd-opt-hint {
  flex: 0 1 auto;
  color: var(--dd-text);
  font-size: 14px;
  font-weight: 400;
  white-space: nowrap;
  opacity: 0.7;
}

.dd-check {
  display: inline-flex;
  flex: 0 0 16px;
  align-items: center;
  justify-content: center;
  width: 16px;
  height: 16px;
}

.dd-check svg {
  width: 15px;
  height: 15px;
  color: var(--dd-ink);
}

.dd-empty {
  padding: 14px 12px;
  color: var(--dd-text);
  font-size: 15px;
  text-align: center;
  opacity: 0.7;
}

.dd-menu.is-sm .dd-opt {
  min-height: 36px;
  font-size: 15px;
}

@media (max-width: 767px) {
  .dd-opt {
    min-height: 44px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .dd-menu {
    animation: none;
  }
}
