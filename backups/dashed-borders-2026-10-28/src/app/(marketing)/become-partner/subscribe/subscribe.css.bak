.sp-page {
  padding: 130px 15px var(--fr-section);
  background-color: var(--fr-cream);
  color: var(--fr-brown);
  font-family: var(--fr-body);
  --sp-danger: var(--lx-danger, #dc4a4a);
}
.sp-wrap {
  max-width: 820px;
  margin: 0 auto;
}

.sp-head {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 14px;
  margin-bottom: 36px;
  text-align: center;
}
.fr .sp-eyebrow {
  padding: 6px 14px;
  border: 1px dashed var(--fr-dark);
  border-radius: var(--fr-radius);
  background-color: var(--fr-yellow);
  color: var(--fr-on-accent);
  font-family: var(--fr-heading);
  font-size: 17px;
  letter-spacing: 0.04em;
  line-height: 1em;
  --app-font: var(--fr-heading);
}
.fr .sp-title {
  font-size: 64px;
}
.fr .sp-sub {
  max-width: 480px;
  font-size: 18px;
}

.sp-card {
  margin: 0;
  overflow: hidden;
  border: 1px dashed var(--fr-dark);
  border-radius: 12px;
  background-color: var(--fr-cream);
}

.sp-plan {
  display: flex;
  align-items: center;
  gap: 16px;
  padding: 20px 28px;
  border-bottom: 1px dashed var(--fr-dark);
  background-color: var(--fr-lime);
}
.sp-plan__icon {
  display: grid;
  flex: 0 0 48px;
  place-items: center;
  width: 48px;
  height: 48px;
  border-radius: var(--fr-radius);
  background-color: var(--fr-dark);
  color: var(--fr-yellow);
}
.sp-plan__icon svg {
  width: 22px;
  height: 22px;
}
.sp-plan__text {
  display: flex;
  flex: 1;
  flex-direction: column;
  gap: 4px;
  min-width: 0;
}
.sp-plan__text b {
  color: var(--fr-brown);
  font-family: var(--fr-heading);
  font-size: 24px;
  font-weight: 400;
  line-height: 1em;
  --app-font: var(--fr-heading);
}
.sp-plan__text span {
  color: var(--fr-brown);
  font-size: 16px;
}
.fr .sp-plan__price {
  flex-shrink: 0;
  color: var(--fr-dark);
  font-family: var(--fr-heading);
  font-size: 40px;
  line-height: 1em;
  white-space: nowrap;
  --app-font: var(--fr-heading);
}
.sp-plan__price small {
  font-family: var(--fr-body);
  font-size: 16px;
}

.sp-body {
  padding: 28px;
}
.fr .sp-alert {
  margin-bottom: 22px;
  padding: 12px 16px;
  border: 1px dashed var(--sp-danger);
  border-radius: var(--fr-radius);
  background-color: color-mix(in srgb, var(--sp-danger) 8%, transparent);
  color: var(--sp-danger);
  font-size: 16px;
  font-weight: 600;
}
.sp-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 20px;
}
.sp-field {
  display: flex;
  flex-direction: column;
  gap: 8px;
  min-width: 0;
}
.sp-field--wide {
  grid-column: 1 / -1;
}
.sp-label {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  color: var(--fr-brown);
  font-family: var(--fr-body);
  font-size: 16px;
  font-weight: 600;
}
.sp-req {
  margin-left: 3px;
  color: var(--sp-danger);
  font-style: normal;
}
.sp-input {
  box-sizing: border-box;
  width: 100%;
  height: 46px;
  margin: 0;
  padding: 0 14px;
  border: 1px dashed var(--fr-dark);
  border-radius: var(--fr-radius);
  background-color: transparent;
  box-shadow: none;
  color: var(--fr-brown);
  font-family: var(--fr-body);
  font-size: 16px;
  outline: none;
  transition: background-color 0.2s ease;
}
.sp-input::placeholder {
  color: var(--fr-brown);
  opacity: 0.5;
}
.sp-input:hover:not(:disabled):not(:focus) {
  background-color: color-mix(in srgb, var(--fr-yellow) 12%, transparent);
}
.sp-input:focus {
  border-style: solid;
  border-color: var(--fr-dark);
  background-color: color-mix(in srgb, var(--fr-yellow) 18%, transparent);
}
.sp-input.is-error {
  border-color: var(--sp-danger);
}
.sp-input:disabled {
  cursor: not-allowed;
  opacity: 0.55;
}
.fr .sp-error {
  color: var(--sp-danger);
  font-size: 14px;
}

.fr .sp-info {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  padding: 0;
  border: 0;
  background: none;
  color: var(--fr-green);
  font-family: var(--fr-body);
  font-size: 15px;
  font-weight: 600;
  text-decoration: underline;
  text-underline-offset: 3px;
  cursor: pointer;
}
.fr .sp-info:hover:not(:disabled) {
  color: var(--fr-dark);
}
.sp-info:disabled {
  cursor: not-allowed;
  opacity: 0.5;
}
.sp-info svg {
  width: 16px;
  height: 16px;
}

.sp-drop {
  position: relative;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8px;
  min-height: 170px;
  padding: 28px 20px;
  border: 1px dashed var(--fr-dark);
  border-radius: var(--fr-radius);
  background-color: transparent;
  text-align: center;
  cursor: pointer;
  transition: background-color 0.2s ease;
}
.sp-drop:hover:not(.is-uploading) {
  background-color: var(--fr-yellow-50);
}
.sp-drop.is-error {
  border-color: var(--sp-danger);
}
.sp-drop.is-uploading {
  cursor: progress;
}
.sp-drop__input {
  position: absolute;
  inset: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  cursor: pointer;
}
.sp-drop__icon {
  display: grid;
  place-items: center;
  width: 52px;
  height: 52px;
  margin-bottom: 4px;
  border: 1px dashed var(--fr-dark);
  border-radius: var(--fr-radius);
  background-color: var(--fr-yellow);
  color: var(--fr-on-accent);
}
.sp-drop__icon svg {
  width: 24px;
  height: 24px;
}
.sp-drop__text {
  color: var(--fr-dark);
  font-family: var(--fr-heading);
  font-size: 20px;
  line-height: 1em;
  --app-font: var(--fr-heading);
}
.sp-drop__hint {
  color: var(--fr-brown);
  font-size: 15px;
  opacity: 0.75;
}

.sp-preview__frame {
  position: relative;
  overflow: hidden;
  border: 1px dashed var(--fr-dark);
  border-radius: var(--fr-radius);
}
.sp-preview__frame img {
  display: block;
  width: 100%;
  max-height: 300px;
  object-fit: contain;
}
.fr .sp-preview__remove {
  position: absolute;
  top: 10px;
  right: 10px;
  display: grid;
  place-items: center;
  width: 38px;
  height: 38px;
  padding: 0;
  border: 1px dashed var(--fr-dark);
  border-radius: var(--fr-radius);
  background-color: var(--fr-cream);
  color: var(--fr-dark);
  cursor: pointer;
  transition: background-color 0.2s ease;
}
.fr .sp-preview__remove:hover:not(:disabled) {
  background-color: var(--fr-yellow);
  color: var(--fr-on-accent);
}
.sp-preview__remove:disabled {
  cursor: not-allowed;
  opacity: 0.5;
}
.sp-preview__remove svg {
  width: 18px;
  height: 18px;
}
.fr .sp-preview__ok {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  margin-top: 12px;
  color: var(--fr-green);
  font-size: 16px;
  font-weight: 600;
}
.sp-preview__ok svg {
  width: 18px;
  height: 18px;
}

.sp-foot {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: space-between;
  gap: 14px 20px;
  padding: 20px 28px;
  border-top: 1px dashed var(--fr-dark);
}
.fr .sp-secure {
  display: flex;
  align-items: center;
  gap: 8px;
  color: var(--fr-brown);
  font-size: 16px;
}
.sp-secure svg {
  width: 16px;
  height: 16px;
  color: var(--fr-green);
}
.fr .sp-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  box-sizing: border-box;
  height: 54px;
  margin: 0;
  padding: 0 28px;
  border: 1px dashed var(--fr-dark);
  border-radius: var(--fr-radius);
  background-color: var(--fr-dark);
  color: var(--fr-yellow);
  font-family: var(--fr-heading);
  font-size: 20px;
  font-weight: 400;
  letter-spacing: 0.01em;
  cursor: pointer;
  transition:
    color 0.4s,
    background-color 0.4s;
  --app-font: var(--fr-heading);
}
.fr .sp-btn:hover:not(:disabled) {
  background-color: var(--fr-yellow);
  color: var(--fr-on-accent);
}
.sp-btn:disabled {
  cursor: progress;
  opacity: 0.7;
}
.sp-btn svg {
  width: 18px;
  height: 18px;
}

.sp-spin {
  animation: sp-spin 0.9s linear infinite;
}
@keyframes sp-spin {
  to {
    transform: rotate(360deg);
  }
}

.sp-modal {
  position: fixed;
  inset: 0;
  z-index: 1200;
  display: grid;
  place-items: center;
  padding: 16px;
  background-color: color-mix(in srgb, var(--fr-dark) 62%, transparent);
  animation: sp-fade 0.18s ease;
}
@keyframes sp-fade {
  from {
    opacity: 0;
  }
}
.sp-modal__box {
  width: 100%;
  max-width: 900px;
  max-height: 90vh;
  overflow-y: auto;
  border: 1px dashed var(--fr-dark);
  border-radius: 12px;
  background-color: var(--fr-cream);
}
.sp-modal__head {
  position: sticky;
  top: 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 20px 24px;
  border-bottom: 1px dashed var(--fr-dark);
  background-color: var(--fr-cream);
}
.fr .sp-modal__title {
  font-size: 32px;
}
.fr .sp-modal__close {
  display: grid;
  flex: none;
  place-items: center;
  width: 40px;
  height: 40px;
  padding: 0;
  border: 1px dashed var(--fr-dark);
  border-radius: var(--fr-radius);
  background: none;
  color: var(--fr-dark);
  cursor: pointer;
}
.fr .sp-modal__close:hover {
  background-color: var(--fr-yellow-50);
}
.sp-modal__close svg {
  width: 20px;
  height: 20px;
}
.sp-modal__body {
  padding: 24px;
}
.fr .sp-modal__desc {
  margin-bottom: 24px;
  text-align: center;
}
.sp-examples {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
  gap: 20px;
}
.sp-example {
  display: flex;
  flex-direction: column;
  gap: 12px;
}
.fr .sp-example__title {
  font-size: 22px;
  text-align: center;
}
.sp-example__frame {
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  aspect-ratio: 16 / 10;
  border: 1px dashed var(--fr-dark);
  border-radius: var(--fr-radius);
}
.sp-example__frame img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: contain;
}
.fr .sp-example__missing {
  font-size: 15px;
  opacity: 0.6;
}

@media (max-width: 991px) {
  .sp-page {
    padding-top: 120px;
  }
}
@media (max-width: 767px) {
  .sp-page {
    padding-top: 104px;
  }
  .fr .sp-title {
    font-size: 44px;
  }
  .sp-plan {
    flex-wrap: wrap;
    padding: 18px;
  }
  .fr .sp-plan__price {
    width: 100%;
    font-size: 34px;
  }
  .sp-body {
    padding: 20px 18px;
  }
  .sp-grid {
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
  }
  .sp-foot {
    padding: 18px;
  }
  .fr .sp-btn {
    width: 100%;
  }
  .sp-modal__head,
  .sp-modal__body {
    padding: 16px 18px;
  }
  .fr .sp-modal__title {
    font-size: 26px;
  }
}
@media (prefers-reduced-motion: reduce) {
  .sp-spin,
  .sp-modal {
    animation: none;
  }
}
