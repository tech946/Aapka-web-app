.fr .co {
  padding: 110px 0 80px;
  background-color: var(--fr-cream);
  color: var(--fr-brown);
  font-family: var(--fr-body);
}
.fr .co .container {
  max-width: 1400px;
  padding-right: 15px;
  padding-left: 15px;
}

.fr .co-crumb {
  padding-top: 24px;
  color: var(--fr-brown);
  font-size: 14px;
}
.fr .co-crumb a {
  color: var(--fr-brown);
}
.fr .co-crumb a:hover {
  color: var(--fr-green);
}
.fr .co-crumb li:last-child {
  color: var(--fr-dark);
}
.fr .co-crumb li:not(:last-child)::after {
  color: var(--fr-dark);
}

.fr .co-head {
  align-items: flex-end;
  padding: 24px 0 32px;
}
.fr .co .ui-eyebrow {
  color: var(--fr-green);
  font-family: var(--fr-body);
  font-size: 13px;
  font-weight: 600;
  letter-spacing: 0.06em;
  text-transform: uppercase;
}
.fr .co-head h1 {
  margin-top: 6px;
  color: var(--fr-brown);
  font-family: var(--fr-display);
  font-size: 56px;
  font-weight: 400;
  letter-spacing: 0;
  line-height: 1em;
  --app-font: var(--fr-display);
  --app-heading-font: var(--fr-display);
}
.fr .co-head__sub {
  margin-top: 10px;
  color: var(--fr-brown);
  font-size: 16px;
  line-height: 1.55;
}

.fr .co-steps {
  gap: 10px;
}
.fr .co-steps li {
  gap: 10px;
  color: var(--fr-brown);
  font-family: var(--fr-heading);
  font-size: 15px;
  font-weight: 600;
  opacity: 0.55;
  --app-font: var(--fr-heading);
  --app-heading-font: var(--fr-heading);
}
.fr .co-steps li.is-done,
.fr .co-steps li.is-on {
  opacity: 1;
}
.fr .co-steps li:not(:last-child)::after {
  width: 32px;
  height: 0;
  border-top: 1px solid var(--fr-hairline);
  background: none;
}
.fr .co-steps li > span {
  width: 34px;
  height: 34px;
  border: 1px solid var(--fr-hairline-strong);
  border-radius: var(--fr-radius);
  background-color: transparent;
  color: var(--fr-dark);
  font-family: var(--fr-heading);
  font-size: 13px;
  font-weight: 600;
  --app-font: var(--fr-heading);
  --app-heading-font: var(--fr-heading);
}
.fr .co-steps li.is-done > span {
  border-color: var(--fr-dark);
  background-color: var(--fr-lime);
  color: var(--fr-dark);
}
.fr .co-steps li.is-on > span {
  border-color: transparent;
  background-color: var(--fr-dark);
  color: var(--fr-on-accent);
}

.fr .co-body {
  grid-template-columns: minmax(0, 1fr) minmax(0, 440px);
  gap: 30px;
}
.fr .co-main {
  gap: 24px;
}

.fr .co-card,
.fr .co-sum,
.fr .co-empty {
  border: 1px solid var(--fr-hairline);
  border-radius: var(--fr-radius-lg);
  background-color: var(--fr-cream);
  box-shadow: var(--fr-shadow);
}
.fr .co-card__head {
  align-items: center;
  gap: 16px;
  padding: 24px 28px;
  border-bottom: 1px solid var(--fr-hairline);
}
.fr .co-card__num {
  flex: 0 0 48px;
  width: 48px;
  height: 48px;
  margin-top: 0;
  border: 1px solid transparent;
  border-radius: var(--fr-radius);
  background-color: var(--fr-yellow);
  box-shadow: none;
  color: var(--fr-on-accent);
  font-family: var(--fr-heading);
  font-size: 19px;
  font-weight: 600;
  --app-font: var(--fr-heading);
  --app-heading-font: var(--fr-heading);
}
.fr .co-card__head .ui-title {
  margin-top: 4px;
  color: var(--fr-brown);
  font-family: var(--fr-heading);
  font-size: 22px;
  font-weight: 700;
  letter-spacing: -0.01em;
  line-height: 1.25;
  --app-font: var(--fr-heading);
  --app-heading-font: var(--fr-heading);
}
.fr .co .ui-desc {
  margin-top: 6px;
  color: var(--fr-brown);
  font-size: 14px;
  opacity: 0.8;
}
.fr .co-card__body {
  padding: 24px 28px 28px;
}
.fr .co-name,
.fr .co .ui-grid {
  gap: 18px 20px;
}
.fr .co-grid {
  margin-top: 18px;
}

.fr .co .ui-label,
.fr .co-file__label {
  color: var(--fr-brown);
  font-family: var(--fr-body);
  font-size: 14px;
  font-weight: 600;
}
.fr .co .ui-hint,
.fr .co .ui-error {
  font-size: 12px;
}
.fr .co .ui-input,
.fr .co .dd-btn {
  height: 50px;
  min-height: 50px;
  padding: 0 14px;
  border: 1px solid var(--fr-hairline-strong);
  border-radius: var(--fr-radius);
  background-color: transparent;
  box-shadow: none;
  color: var(--fr-brown);
  font-family: var(--fr-body);
  font-size: 15px;
}
.fr .co textarea.ui-input {
  height: auto;
  min-height: 96px;
  padding: 12px 14px;
}
.fr .co .ui-input::placeholder,
.fr .co .dd-value.is-ph {
  color: var(--fr-brown);
  opacity: 0.5;
}
.fr .co .ui-input:hover:not(:disabled):not(:focus),
.fr .co .dd-btn:hover {
  border-color: var(--fr-yellow);
  background-color: var(--fr-soft);
}
.fr .co .ui-input:focus,
.fr .co .dd-btn:focus-visible,
.fr .co .dd.is-open .dd-btn {
  border-style: solid;
  border-color: var(--fr-yellow);
  background-color: transparent;
  box-shadow: 0 0 0 3px color-mix(in srgb, var(--fr-yellow) 20%, transparent);
}
.fr .co .ui-field.has-error .ui-input,
.fr .co .ui-input.is-error,
.fr .co .dd.is-invalid .dd-btn {
  border-color: var(--lx-danger);
}

.fr .co-pickup {
  padding: 12px 14px;
  border: 1px solid var(--fr-hairline);
  border-radius: var(--fr-radius);
  background-color: var(--fr-lime);
  color: var(--fr-brown);
  font-size: 14px;
}
.fr .co-pickup svg {
  color: var(--fr-dark);
}

.fr .co-docs {
  margin-top: 28px;
  padding-top: 24px;
  border-top: 1px solid var(--fr-hairline);
}
.fr .co-docs--flush {
  margin-top: 0;
  padding-top: 0;
  border-top: 0;
}
.fr .co-docs__title {
  margin-bottom: 16px;
  color: var(--fr-brown);
  font-family: var(--fr-heading);
  font-size: 16px;
  font-weight: 600;
  --app-font: var(--fr-heading);
  --app-heading-font: var(--fr-heading);
}
.fr .co-docs__title svg {
  color: var(--fr-dark);
}
.fr .co-drop {
  border: 1.5px dashed var(--fr-hairline-strong);
  border-radius: var(--fr-radius);
  background-color: transparent;
}
.fr .co-drop:hover,
.fr .co-drop.is-dragging {
  border-color: var(--fr-yellow);
  background-color: var(--fr-soft);
}
.fr .co-drop.has-file {
  border-style: solid;
  border-color: var(--fr-hairline-strong);
  background-color: transparent;
}
.fr .co-drop__empty {
  color: var(--fr-brown);
}
.fr .co-drop__empty svg {
  border: 1px solid transparent;
  border-radius: var(--fr-radius);
  background-color: var(--fr-yellow);
  color: var(--fr-on-accent);
}
.fr .co-drop__empty b {
  color: var(--fr-dark);
  font-family: var(--fr-heading);
  font-size: 13px;
  font-weight: 600;
  --app-font: var(--fr-heading);
  --app-heading-font: var(--fr-heading);
}
.fr .co-drop__empty small,
.fr .co-drop__name {
  color: var(--fr-brown);
  font-size: 12px;
}
.fr .co-drop__remove {
  border: 1px solid var(--fr-hairline-strong);
  border-radius: var(--fr-radius);
  background-color: var(--fr-cream);
  color: var(--fr-dark);
}

.fr .co-note {
  margin-top: 18px;
  padding: 12px 14px;
  border: 1px solid var(--fr-hairline);
  border-radius: var(--fr-radius);
  background-color: var(--fr-yellow-50);
  color: var(--fr-dark);
  font-size: 13px;
}

.fr .co-aside {
  top: 24px;
}
.fr .co-sum__head {
  align-items: center;
  gap: 16px;
  padding: 20px;
  border-bottom: 1px solid var(--fr-hairline);
}
.fr .co-sum__img {
  width: 88px;
  height: 88px;
  border-radius: var(--fr-radius);
}
.fr .co-sum__title h2 {
  margin-top: 4px;
  color: var(--fr-brown);
  font-family: var(--fr-heading);
  font-size: 19px;
  font-weight: 600;
  letter-spacing: 0;
  line-height: 1.25;
  --app-font: var(--fr-heading);
  --app-heading-font: var(--fr-heading);
}
.fr .co-sum__dur {
  height: 26px;
  margin-top: 8px;
  padding: 0 10px;
  border: 1px solid transparent;
  border-radius: var(--fr-radius);
  background-color: var(--fr-yellow);
  color: var(--fr-on-accent);
  font-family: var(--fr-heading);
  font-size: 12px;
  font-weight: 600;
  --app-font: var(--fr-heading);
  --app-heading-font: var(--fr-heading);
}
.fr .co-sum__body {
  padding: 20px;
  border-bottom: 1px solid var(--fr-hairline);
}
.fr .co-sum__head + .co-sum__body {
  background-color: var(--fr-lime);
}
.fr .co-facts {
  gap: 10px;
}
.fr .co-facts li {
  color: var(--fr-brown);
  font-size: 15px;
  font-weight: 500;
}
.fr .co-facts svg {
  color: var(--fr-dark);
}
.fr .co-addons__label {
  color: var(--fr-brown);
  font-size: 12px;
}
.fr .co-chip,
.fr .co-chip.is-muted {
  height: 26px;
  padding: 0 10px;
  border: 1px solid transparent;
  border-radius: 6px;
  background-color: var(--fr-indigo-soft);
  color: var(--fr-green);
  font-size: 12px;
  font-weight: 600;
}
.fr .co-change {
  margin-top: 16px;
  color: var(--fr-dark);
  font-family: var(--fr-heading);
  font-size: 13px;
  font-weight: 600;
  text-decoration: underline;
  text-underline-offset: 3px;
  --app-font: var(--fr-heading);
  --app-heading-font: var(--fr-heading);
}
.fr .co-change:hover {
  color: var(--fr-green);
}

.fr .co-sum__label {
  margin-bottom: 12px;
  color: var(--fr-brown);
  font-family: var(--fr-heading);
  font-size: 16px;
  font-weight: 600;
  --app-font: var(--fr-heading);
  --app-heading-font: var(--fr-heading);
}
.fr .co-sum__hint,
.fr .co-sum__pricing {
  color: var(--fr-brown);
  font-size: 13px;
}
.fr .co-pay {
  gap: 10px;
}
.fr .co-pay__opt {
  gap: 12px;
  padding: 14px 16px;
  border: 1px solid var(--fr-hairline-strong);
  border-radius: var(--fr-radius);
  background-color: transparent;
  box-shadow: none;
}
.fr .co-pay__opt:hover {
  border-color: color-mix(in srgb, var(--fr-dark) 45%, transparent);
  background-color: color-mix(in srgb, var(--fr-yellow) 25%, transparent);
}
.fr .co-pay__opt.is-on {
  border-color: var(--fr-yellow);
  background-color: var(--fr-lime);
  box-shadow: none;
}
.fr .co-pay__opt input[type='radio'] {
  flex-basis: 20px;
  width: 20px;
  height: 20px;
  border: 1px solid var(--fr-dark);
  background-color: var(--fr-cream);
}
.fr .co-pay__opt input[type='radio']:checked {
  border-color: transparent;
  background-color: var(--fr-yellow);
}
.fr .co-pay__opt input[type='radio']:checked::after {
  inset: 4px;
  background-color: var(--fr-on-accent);
}
.fr .co-pay__text b {
  color: var(--fr-brown);
  font-size: 15px;
}
.fr .co-pay__text small {
  color: var(--fr-brown);
  font-size: 12px;
  opacity: 0.8;
}
.fr .co-pay__amt {
  color: var(--fr-dark);
  font-family: var(--fr-heading);
  font-size: 16px;
  font-weight: 600;
  --app-font: var(--fr-heading);
  --app-heading-font: var(--fr-heading);
}

.fr .co-lines {
  gap: 10px;
}
.fr .co-lines li {
  color: var(--fr-brown);
  font-size: 14px;
}
.fr .co-lines__price {
  color: var(--fr-brown);
}
.fr .co-total {
  align-items: center;
  margin-top: 16px;
  padding-top: 16px;
  border-top: 1px solid var(--fr-hairline);
}
.fr .co-total span {
  color: var(--fr-brown);
  font-family: var(--fr-heading);
  font-size: 16px;
  font-weight: 600;
  --app-font: var(--fr-heading);
  --app-heading-font: var(--fr-heading);
}
.fr .co-total b {
  color: var(--fr-dark);
  font-family: var(--fr-display);
  font-size: 40px;
  font-weight: 400;
  letter-spacing: 0;
  line-height: 1em;
  --app-font: var(--fr-display);
  --app-heading-font: var(--fr-display);
}

.fr .co-sum__foot {
  gap: 14px;
  padding: 20px;
  background-color: var(--fr-cream);
}
.fr .co-secure {
  color: var(--fr-brown);
  font-size: 12px;
}
.fr .co-secure > svg {
  color: var(--fr-green);
}
.fr .co-secure__loc {
  color: var(--fr-brown);
  opacity: 0.7;
}

.fr .co .ui-btn {
  height: 52px;
  padding: 0 26px;
  border: 1px solid var(--fr-hairline-strong);
  border-radius: var(--fr-radius);
  background-color: transparent;
  box-shadow: none;
  color: var(--fr-dark);
  font-family: var(--fr-heading);
  font-size: 14px;
  font-weight: 600;
  transition:
    color 0.4s,
    background-color 0.4s;
  --app-font: var(--fr-heading);
  --app-heading-font: var(--fr-heading);
}
.fr .co .ui-btn--lg {
  height: 56px;
}
.fr .co .ui-btn--primary,
.fr .co .ui-btn--dark {
  border-color: transparent;
  background-color: var(--fr-dark);
  color: var(--fr-on-accent);
}
.fr .co .ui-btn:hover:not(:disabled),
.fr .co .ui-btn--primary:hover:not(:disabled),
.fr .co .ui-btn--dark:hover:not(:disabled) {
  border-color: transparent;
  background-color: var(--fr-yellow);
  color: var(--fr-on-accent);
}
.fr .co .ui-btn svg {
  width: 16px;
  height: 16px;
}

.fr .co-empty {
  gap: 12px;
  margin-top: 64px;
  padding: 44px 32px;
}
.fr .co-empty h1 {
  color: var(--fr-brown);
  font-family: var(--fr-display);
  font-size: 40px;
  font-weight: 400;
  line-height: 1em;
  --app-font: var(--fr-display);
  --app-heading-font: var(--fr-display);
}
.fr .co-empty p {
  color: var(--fr-brown);
  font-size: 16px;
}
.fr .co-empty--loading {
  border: 0;
  background-color: transparent;
  box-shadow: none;
}

@media (max-width: 1199px) {
  .fr .co-body {
    grid-template-columns: minmax(0, 1fr) minmax(0, 380px);
  }
}
@media (max-width: 1023px) {
  .fr .co-body {
    grid-template-columns: minmax(0, 1fr);
  }
}
@media (max-width: 991px) {
  .fr .co {
    padding-top: 100px;
  }
}
@media (max-width: 767px) {
  .fr .co {
    padding-top: 96px;
  }
  .fr .co-head h1 {
    font-size: 40px;
  }
  .fr .co-steps li {
    font-size: 13px;
  }
  .fr .co-steps li:not(:last-child)::after {
    width: 14px;
  }
  .fr .co-card__head {
    padding: 18px;
  }
  .fr .co-card__body {
    padding: 18px 18px 22px;
  }
  .fr .co-card__head .ui-title {
    font-size: 19px;
  }
}

.fr .co .ui-btn--primary svg,
.fr .co .ui-btn--dark svg {
  color: var(--fr-on-accent);
}
