  { icon: TrendingUp, text: 'Access to exclusive partner discounts on all packages' },
  { icon: Zap, text: 'Priority customer support' },
  { icon: Shield, text: 'Dedicated partner dashboard' },
  { icon: Users, text: 'Real-time booking management' },
  { icon: Award, text: 'Commission tracking and invoicing' },
];

export default function BecomeAgentPage() {
  const router = useRouter();

  return (
    <div className={'fr ' + FR_FONTS}>
      <FrHeader />
      <main>
        <section className="fr-section bp-banner">
          <div className="fr-container">
            <div className="bp-banner__flex">
              <img src={BANNER_LEFT} alt="" className="bp-banner__img bp-banner__img--left" />
              <div className="bp-banner__text">
                <p className="bp-eyebrow">Premium membership</p>
                <h1 className="bp-banner__title">Become a Partner</h1>
                <div className="fr-para-width">
                  <p>Join our network of Aapka travel partners and unlock exclusive benefits.</p>
                </div>
              </div>
              <img src={BANNER_RIGHT} alt="" className="bp-banner__img bp-banner__img--right" />
            </div>
          </div>
        </section>

        <section className="fr-section bp-plan">
          <div className="fr-container">
            <div className="bp-plan__grid">
              <div className="bp-perks">
                <h2 className="bp-perks__title">What&apos;s included</h2>
                <ul className="bp-perks__list">
                  {FEATURES.map(({ icon: Icon, text }) => (
                    <li key={text} className="bp-perk">
                      <span className="bp-perk__icon" aria-hidden="true">
                        <Icon />
                      </span>
                      <p>{text}</p>
                    </li>
                  ))}
                </ul>
              </div>

              <div className="bp-card">
                <span className="bp-card__tag">Most popular</span>
                <div className="bp-card__head">
                  <span className="bp-card__icon" aria-hidden="true">
                    <Shield />
                  </span>
                  <h3 className="bp-card__title">Aapka Partner Premium</h3>
